{
  "name": "btaml-blockchain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "network": "node --env-file-if-exists=.env --import tsx scripts/network.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "demo": "node --import tsx scripts/demo.ts",
    "experiment": "node --import tsx scripts/experiment.ts",
    "light-client": "node --import tsx scripts/light-client.ts",
    "block-selection": "node --import tsx scripts/block-selection.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "swagger-ui-dist": "^5.35.0"
  }
}
